# RemindMe — пример переменных окружения.
# Скопируйте в .env и заполните реальными значениями.
# .env НЕ попадает в образ (Docker) и в репозиторий (.gitignore).

# Обязательный токен Telegram-бота от @BotFather.
TELEGRAM_BOT_TOKEN=

# URL подключения к базе данных (по умолчанию sqlite+aiosqlite:///data/remindme.db).
DATABASE_URL=sqlite+aiosqlite:///data/remindme.db

# Часовой пояс по умолчанию для новых пользователей (IANA, напр. Europe/Moscow).
DEFAULT_TIMEZONE=Europe/Moscow

# Время напоминания по умолчанию в формате ЧЧ:ММ (24-часовой).
DEFAULT_REMINDER_TIME=09:00

# Интервал опроса worker в секундах (> 0).
REMINDER_POLL_INTERVAL_SECONDS=5

# Уровень логирования (DEBUG/INFO/WARNING/ERROR/CRITICAL).
LOG_LEVEL=INFO
